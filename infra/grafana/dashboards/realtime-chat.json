    {
     "refId": "B",
     "expr": "sum(rate(chat_ws_resume_replayed_total[1m]))",
     "legendFormat": "resume replayed"
    },
    {
     "refId": "C",
     "expr": "sum(rate(chat_client_seq_gap_total[1m]))",
     "legendFormat": "client seq gap"
    }
   ]
  },
  {
   "id": 8,
   "type": "row",
   "title": "비동기 파이프라인 (Outbox → Projection / Snapshot)",
